# Copy to .env.local (gitignored) and fill in. The scripts source .env.local via
# scripts/common.sh; config.py also reads a plain .env for local non-script runs.

# The Odds API key. Liga MX sport key is soccer_mexico_ligamx.
# Drives the "Now" line fetch and the pre-kickoff closing capture.
# Free tier is 500 requests/MONTH -- see SETUP_CAPTURE.md before widening any
# capture window, the budget is tighter than it looks.
THE_ODDS_API_KEY=

# odds-api.io key. Drives the opening-line capture (Betano UK + Duel) and the
# historical closes backfill. Free tier is ~500/day, 100/hour.
# The account may select at most 2 recreational bookmakers; the authoritative
# list is the 403 body of /odds/multi, not /bookmakers/selected.
ODDS_API_IO_KEY=

# Telegram alerts (deferred; only needed once the notify layer is wired up).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
