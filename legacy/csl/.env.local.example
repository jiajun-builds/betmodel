# Copy this file to .env.local and fill in your real keys.
# This file should stay local and should not be committed.

# xG is fetched from the official SofaScore API — no key required.

# Pinnacle opening/Now lines (~500 requests per MONTH on the free plan — the reason
# the capture scheduler is so careful about idle ticks).
THE_ODDS_API_KEY=your_the_odds_api_key_here

# 1xBet opening lines (~500 requests per DAY, 100/hour). Different provider because
# the daily budget is what lets csl.odds.fetch_onexbet_open poll without a predicted
# opening window — see that module's docstring.
ODDS_API_IO_KEY=your_odds_api_io_key_here

# Optional overrides
# PYTHON=python3
# CSL_ENV_NAME=csl-workflows
# Only needed if conda cannot be found automatically (e.g. an unusual install
# location). Point at <conda-base>/etc/profile.d/conda.sh — find your base with
# `conda info --base`.
# CSL_CONDA_SH=/opt/homebrew/Caskroom/miniconda/base/etc/profile.d/conda.sh
